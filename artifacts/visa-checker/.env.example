# Google Analytics 4
# Get your Measurement ID from Google Analytics → Admin → Data Streams → your stream
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense
# Get your Publisher ID from Google AdSense → Account → Account information
# Format: ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX

# Set to "true" to activate ad slots across the site (requires publisher ID above)
# Leave as "false" or unset to hide all ads (safe for development / pre-approval)
VITE_ADSENSE_ENABLED=false
